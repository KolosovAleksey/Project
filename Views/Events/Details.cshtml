@model EventDetailsViewModel
@{
    ViewData["Title"] = Model.Title;
}
<div class="row">
    <div class="col-md-8">
        <h1>@Model.Title</h1>
        <div class="mb-3">
            <span class="badge bg-secondary">@Model.CategoryName</span>
            <span class="badge @(Model.Status == "completed" ? "bg-danger" : Model.Status == "ongoing" ? "bg-success" : "bg-warning")">
                @Model.Status
            </span>
        </div>
        <p><strong>Площадка:</strong> @Model.VenueName, @Model.VenueAddress</p>
        <p><strong>Дата и время:</strong> @Model.StartDateTime.ToString("g") – @Model.EndDateTime.ToString("t")</p>
        <p><strong>Вместимость:</strong> @Model.Capacity, <strong>Свободно:</strong> @Model.FreePlaces</p>
        <p class="mt-4">@Model.Description</p>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Запись на мероприятие</h5>
                @if (User.Identity.IsAuthenticated)
                {
                    if (Model.Status == "completed")
                    {
                        <div class="alert alert-warning">Мероприятие завершено, запись невозможна.</div>
                    }
                    else if (Model.FreePlaces == 0)
                    {
                        <div class="alert alert-danger">Свободных мест нет.</div>
                    }
                    else if (Model.UserAlreadyRegistered)
                    {
                        <div class="alert alert-info">Вы уже записаны на это мероприятие.</div>
                    }
                    else
                    {
                        <form asp-controller="Events" asp-action="Register" method="post">
                            <input type="hidden" name="eventId" value="@Model.Id" />
                            <button type="submit" class="btn btn-success w-100">Записаться</button>
                        </form>
                    }
                }
                else
                {
                    <div class="alert alert-secondary">Чтобы записаться, <a asp-controller="Account" asp-action="Login">войдите</a> или <a asp-controller="Account" asp-action="Register">зарегистрируйтесь</a>.</div>
                }
            </div>
        </div>
    </div>
</div>
